        ],
        "summary": "Get Sitemap XML",
        "description": "Get Sitemap XML for Storefront.",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "value": "<urlset/>"
                }
              }
            }
          }
        }
      }
    },
    "/public/storefront/robots.txt": {
      "get": {
        "tags": [
          "Storefront"
        ],
        "summary": "Get Robots",
        "description": "Get Robots for Storefront.",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "value": "User-agent: *"
                }
              }
            }
          }
        }
      }
    }
  }
}
