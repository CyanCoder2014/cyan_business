      "post": {
        "tags": [
          "AI Orchestrator Internal"
        ],
        "summary": "Generate Platform App Internal",
        "description": "Generate Platform App Internal for AI Orchestrator Internal.",
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "prompt": "Generate a tenant blueprint draft for a store.",
                "appType": "ECOMMERCE",
                "tenantKey": "{{tenant_key}}",
                "siteKey": "{{site_key}}",
                "clientKey": "{{client_key}}",
                "execute": false,
                "answers": {
                  "subdomain": "internal-spiffy"
                },
                "availableServiceKeys": [
                  "ai-orchestrator-service",
                  "notification-service",
                  "bpm-service",
                  "automation-orchestrator-service",
                  "report-service",
                  "sso-auth-service",
                  "sso-user-service",
                  "sso-captcha-service",
                  "media-service",
                  "processor-service",
                  "batch-worker-service",
                  "api-docs-service"
                ]
              }
            }
          }
        }
      }
    },
