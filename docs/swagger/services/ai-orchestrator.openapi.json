              },
              "example": {
                "channelType": "CHAT",
                "tenantKey": "{{tenant_key}}",
                "siteKey": "{{site_key}}",
                "clientKey": "{{client_key}}",
                "draftId": "{{draft_id}}",
                "appTypeHint": "ECOMMERCE",
                "title": "Spiffy Intake",
                "extractedAnswers": {
                  "subdomain": "spiffy-demo"
                }
              }
            }
          }
        }
      }
    },
