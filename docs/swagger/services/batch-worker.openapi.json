{
  "openapi": "3.0.3",
  "info": {
    "title": "Cyan Business Platform API",
    "version": "1.0.0",
    "description": "Static OpenAPI inventory for the platform, grouped by microservice. Auth support includes Bearer JWT for endpoint/api routes and Basic Auth for internal routes."
  },
  "servers": [
    {
      "url": "{gateway_base_url}",
      "description": "Gateway base URL",
      "variables": {
        "gateway_base_url": {
          "default": "http://localhost:8001"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Batch Worker"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "paths": {
    "/endpoint/batch/definitions": {
      "post": {
        "tags": [
          "Batch Worker"
        ],
        "summary": "Save Batch Definition",
        "description": "Save Batch Definition for Batch Worker.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "definitionKey": "importer-order-projection-v1",
                "title": "Import orders into the customer credit projection",
                "active": true,
                "spec": {
                  "source": {
                    "url": "https://importer.example/v1/orders?status=CONFIRMED",
                    "itemsPath": "content",
                    "pageParameter": "page",
                    "sizeParameter": "size",
                    "pageSize": 500,
                    "headers": {
                      "Accept": "application/json"
                    },
                    "bearerTokenEnvironmentVariable": "IMPORTER_API_TOKEN"
                  },
                  "destination": {
                    "url": "https://projection.example/v1/credit-projection/order-events",
                    "method": "POST",
                    "itemKeyPath": "eventKey",
                    "headers": {
                      "X-Projection-Key": "importer-credit-v1"
                    },
                    "bearerTokenEnvironmentVariable": "PROJECTION_API_TOKEN"
                  },
                  "fieldMappings": {
                    "eventKey": "orderId",
                    "customerKey": "customer.id",
                    "createdAt": "createdAt",
                    "totalAmount": "totalAmount"
                  },
                  "chunkSize": 200,
                  "retryLimit": 5,
                  "skipLimit": 100
                }
              }
            }
          }
        }
      }
    },
    "/endpoint/batch/definitions/{definitionKey}": {
      "get": {
        "tags": [
          "Batch Worker"
        ],
        "summary": "Get Batch Definition",
        "description": "Get Batch Definition for Batch Worker.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "definitionKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{batch_definition_key}}"
          }
        ]
      }
    },
    "/endpoint/batch/definitions/{definitionKey}/runs": {
      "post": {
        "tags": [
          "Batch Worker"
        ],
        "summary": "Start Batch Run",
        "description": "Start Batch Run for Batch Worker.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "definitionKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{batch_definition_key}}"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "runKey": "2026-07-25T04:30:00Z"
              }
            }
          }
        }
      }
    },
    "/endpoint/batch/runs/{id}": {
      "get": {
        "tags": [
          "Batch Worker"
        ],
        "summary": "Get Batch Run",
        "description": "Get Batch Run for Batch Worker.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{id}}"
          }
        ]
      }
    },
    "/endpoint/batch/runs": {
      "get": {
        "tags": [
          "Batch Worker"
        ],
        "summary": "List Batch Runs",
        "description": "List Batch Runs for Batch Worker.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "50"
          }
        ]
      }
    },
    "/endpoint/batch/runs/{id}/rejected-items": {
      "get": {
        "tags": [
          "Batch Worker"
        ],
        "summary": "List Rejected Batch Items",
        "description": "List Rejected Batch Items for Batch Worker.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{id}}"
          }
        ]
      }
    },
    "/endpoint/batch/runs/{id}/retry": {
      "post": {
        "tags": [
          "Batch Worker"
        ],
        "summary": "Retry Batch Run",
        "description": "Retry Batch Run for Batch Worker.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{id}}"
          }
        ]
      }
    }
  }
}
