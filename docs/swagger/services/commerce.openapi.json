{
  "openapi": "3.0.3",
  "info": {
    "title": "Cyan Business Platform API",
    "version": "1.0.0",
    "description": "Static OpenAPI inventory for the platform, grouped by microservice. Auth support includes Bearer JWT for endpoint/api routes and Basic Auth for internal routes."
  },
  "servers": [
    {
      "url": "{gateway_base_url}",
      "description": "Gateway base URL",
      "variables": {
        "gateway_base_url": {
          "default": "http://localhost:8001"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Commerce"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "paths": {
    "/api/commerce-service/documents": {
      "post": {
        "tags": [
          "Commerce"
        ],
        "summary": "Create Commerce Document",
        "description": "Create Commerce Document for Commerce.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "documentKey": "document-1001",
                "title": "Sample Commerce Document",
                "status": "ACTIVE",
                "payload": {
                  "source": "postman",
                  "tenantKey": "{{tenant_key}}",
                  "siteKey": "{{site_key}}"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Commerce"
        ],
        "summary": "List Commerce Documents",
        "description": "List Commerce Documents for Commerce.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/commerce-service/documents/{documentKey}": {
      "get": {
        "tags": [
          "Commerce"
        ],
        "summary": "Get Commerce Document",
        "description": "Get Commerce Document for Commerce.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "documentKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "document-1001"
          }
        ]
      },
      "put": {
        "tags": [
          "Commerce"
        ],
        "summary": "Update Commerce Document",
        "description": "Update Commerce Document for Commerce.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "documentKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "document-1001"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "documentKey": "document-1001",
                "title": "Sample Commerce Document",
                "status": "ACTIVE",
                "payload": {
                  "source": "postman",
                  "tenantKey": "{{tenant_key}}",
                  "siteKey": "{{site_key}}"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Commerce"
        ],
        "summary": "Delete Commerce Document",
        "description": "Delete Commerce Document for Commerce.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "documentKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "document-1001"
          }
        ]
      }
    },
    "/api/commerce-service/documents/internal/export": {
      "get": {
        "tags": [
          "Commerce"
        ],
        "summary": "Export Commerce",
        "description": "Export Commerce for Commerce.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    }
  }
}
