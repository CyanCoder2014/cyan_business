{
  "openapi": "3.0.3",
  "info": {
    "title": "Cyan Business Platform API",
    "version": "1.0.0",
    "description": "Static OpenAPI inventory for the platform, grouped by microservice. Auth support includes Bearer JWT for endpoint/api routes and Basic Auth for internal routes."
  },
  "servers": [
    {
      "url": "{gateway_base_url}",
      "description": "Gateway base URL",
      "variables": {
        "gateway_base_url": {
          "default": "http://localhost:8080"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Report"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "paths": {
    "/api/report-service/reports": {
      "post": {
        "tags": [
          "Report"
        ],
        "summary": "Create Report",
        "description": "Create Report for Report.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "reportKey": "sales-summary",
                "title": "Sales Summary",
                "status": "ACTIVE",
                "definition": {
                  "type": "TABLE",
                  "entityKey": "order"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Report"
        ],
        "summary": "List Reports",
        "description": "List Reports for Report.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        }
      }
    },
    "/api/report-service/reports/{reportKey}": {
      "get": {
        "tags": [
          "Report"
        ],
        "summary": "Get Report",
        "description": "Get Report for Report.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "reportKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "sales-summary"
          }
        ]
      },
      "put": {
        "tags": [
          "Report"
        ],
        "summary": "Update Report",
        "description": "Update Report for Report.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "reportKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "sales-summary"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "reportKey": "sales-summary",
                "title": "Sales Summary Updated",
                "status": "ACTIVE",
                "definition": {
                  "type": "TABLE",
                  "entityKey": "order"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "Report"
        ],
        "summary": "Delete Report",
        "description": "Delete Report for Report.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "reportKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "sales-summary"
          }
        ]
      }
    },
    "/api/report-service/reports/{reportKey}/run": {
      "post": {
        "tags": [
          "Report"
        ],
        "summary": "Run Report",
        "description": "Run Report for Report.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "reportKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "sales-summary"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "filters": {
                  "status": "PAID"
                }
              }
            }
          }
        }
      }
    }
  }
}
