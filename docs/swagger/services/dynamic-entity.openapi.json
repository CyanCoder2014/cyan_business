{
  "openapi": "3.0.3",
  "info": {
    "title": "Cyan Business Platform API",
    "version": "1.0.0",
    "description": "Static OpenAPI inventory for the platform, grouped by microservice. Auth support includes Bearer JWT for endpoint/api routes and Basic Auth for internal routes."
  },
  "servers": [
    {
      "url": "{gateway_base_url}",
      "description": "Gateway base URL",
      "variables": {
        "gateway_base_url": {
          "default": "http://localhost:8001"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Dynamic Entity"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "paths": {
    "/endpoint/entities/definitions": {
      "post": {
        "tags": [
          "Dynamic Entity"
        ],
        "summary": "Create Definition",
        "description": "Create Definition for Dynamic Entity.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "entityKey": "catalog-item",
                "tenantKey": "demo-tenant",
                "siteKey": "main-site",
                "definition": {
                  "entityKey": "catalog-item",
                  "title": "Catalog Item",
                  "fields": [
                    {
                      "key": "title",
                      "type": "text",
                      "required": true
                    },
                    {
                      "key": "price",
                      "type": "number",
                      "required": true
                    },
                    {
                      "key": "status",
                      "type": "select",
                      "options": [
                        "DRAFT",
                        "PUBLISHED"
                      ]
                    }
                  ]
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Dynamic Entity"
        ],
        "summary": "List Definitions",
        "description": "Paginated tenant/site-scoped entity definitions. Default page=0, size=20; maximum size=200. Supported sort fields: entityKey, title, entityType, createdAt, updatedAt.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "0"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "20"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "entityKey,asc"
          }
        ]
      }
    },
