{
  "openapi": "3.0.3",
  "info": {
    "title": "Cyan Business Platform API",
    "version": "1.0.0",
    "description": "Static OpenAPI inventory for the platform, grouped by microservice. Auth support includes Bearer JWT for endpoint/api routes and Basic Auth for internal routes."
  },
  "servers": [
    {
      "url": "{gateway_base_url}",
      "description": "Gateway base URL",
      "variables": {
        "gateway_base_url": {
          "default": "http://localhost:8001"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Search Internal"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "paths": {
    "/internal/search-index/search": {
      "get": {
        "tags": [
          "Search Internal"
        ],
        "summary": "Search Internal",
        "description": "Search Internal for Search Internal.",
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "crm customer"
          },
          {
            "name": "entityTypes",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "crm-record"
          }
        ]
      }
    },
    "/internal/search-index/sync/{sourceServiceKey}/{sourceEntityKey}": {
      "post": {
        "tags": [
          "Search Internal"
        ],
        "summary": "Sync Search Index",
        "description": "Sync Search Index for Search Internal.",
        "security": [
          {
            "BasicAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "sourceServiceKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "catalog-service"
          },
          {
            "name": "sourceEntityKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "catalog-item"
          }
        ]
      }
    }
  }
}
