{
  "openapi": "3.0.3",
  "info": {
    "title": "Cyan Business Platform API",
    "version": "1.0.0",
    "description": "Static OpenAPI inventory for the platform, grouped by microservice. Auth support includes Bearer JWT for endpoint/api routes and Basic Auth for internal routes."
  },
  "servers": [
    {
      "url": "{gateway_base_url}",
      "description": "Gateway base URL",
      "variables": {
        "gateway_base_url": {
          "default": "http://localhost:8080"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Payment Public"
    }
  ],
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "BasicAuth": {
        "type": "http",
        "scheme": "basic"
      }
    }
  },
  "paths": {
    "/public/payment/callback/{providerCode}/{transactionKey}": {
      "get": {
        "tags": [
          "Payment Public"
        ],
        "summary": "Payment Callback GET",
        "description": "Payment Callback GET for Payment Public.",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "providerCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "ZARINPAL"
          },
          {
            "name": "transactionKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{transaction_key}}"
          },
          {
            "name": "Authority",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "A0000001"
          },
          {
            "name": "Status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "OK"
          }
        ]
      },
      "post": {
        "tags": [
          "Payment Public"
        ],
        "summary": "Payment Callback POST",
        "description": "Payment Callback POST for Payment Public.",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "providerCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "ZARINPAL"
          },
          {
            "name": "transactionKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{transaction_key}}"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "Authority": "A0000001",
                "Status": "OK"
              }
            }
          }
        }
      }
    },
    "/public/payment/simulate/{providerCode}/{transactionKey}": {
      "get": {
        "tags": [
          "Payment Public"
        ],
        "summary": "Simulate Payment Callback",
        "description": "Simulate Payment Callback for Payment Public.",
        "security": [],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "ok"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "providerCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "ZARINPAL"
          },
          {
            "name": "transactionKey",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "{{transaction_key}}"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "SUCCESS"
          }
        ]
      }
    }
  }
}
