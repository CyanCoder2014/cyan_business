                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "contentKey": "content-1001",
                "title": "Sample Content Content",
                "status": "ACTIVE",
                "payload": {
                  "source": "postman",
                  "tenantKey": "{{tenant_key}}",
                  "siteKey": "{{site_key}}"
                }
              }
            }
          }
        }
