        ],
        "summary": "Create Conversation Session",
        "description": "Create Conversation Session for AI Orchestrator.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
