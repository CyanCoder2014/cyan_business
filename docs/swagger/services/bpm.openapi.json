        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": true
              },
              "example": {
                "flowKey": "customer-onboarding",
                "version": 1,
                "active": true,
                "states": [
                  {
                    "key": "DRAFT",
                    "label": "Draft",
                    "automatic": false,
                    "waitForAutomation": false
                  },
                  {
                    "key": "REVIEW",
                    "label": "Review",
                    "automatic": false,
                    "waitForAutomation": true
                  }
                ],
                "actions": [
                  {
                    "type": "RUN_AUTOMATION_BLOCK",
                    "params": {
                      "blockKey": "credit-check",
                      "automationFlowKey": "credit-screening",
                      "executionMode": "ASYNC",
                      "failurePolicy": "MARK_FAILED",
                      "body": {
                        "customerKey": "{{record_key}}"
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
